<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="wuliuma"
    ExtensionBundleVersion="3.4.0"
    ExtensionBundleName="wuliuma"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- v2.9: 原本是两条 <Extension>(organizeImages / barcodeGenerator), 各自一个菜单项。
         用户拍板把两个面板合并成一个(顶部页签切换) ⇒ 两条并成一条。
         ⚠ 两个旧 Extension Id 随之消失 —— 已存的 Illustrator 工作区里那两个面板会空掉, 需要重新拖一次。
         2026-10-23 (v3.4): BundleId / Extension Id / 菜单名统一改成 wuliuma / wuliuma.combo / 「物流码」。
         ⚠ CEP 要求 Extension Id 以 BundleId 开头 ⇒ 保留 .combo 后缀, 只换前缀。 -->
    <ExtensionList>
        <Extension Id="wuliuma.combo" Version="3.4.0" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[16.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="wuliuma.combo">
            <DispatchInfo>
                <Resources>
                    <MainPath>./panels/panel.html</MainPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>物流码</Menu>
                    <Geometry>
                        <!-- v1.2: 面板高度固定为上一版(420)的两倍,不再做动态自适应 -->
                        <Size><Width>360</Width><Height>840</Height></Size>
                        <MinSize><Width>330</Width><Height>320</Height></MinSize>
                        <MaxSize><Width>420</Width><Height>1100</Height></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
